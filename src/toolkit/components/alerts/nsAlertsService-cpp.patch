+// Kiwi: the do-not-disturb timer for web notifications, in unix seconds.
+// 0 means off, -1 means forever.
+bool KiwiDndActive() {
+  int32_t until = Preferences::GetInt("kiwi.dnd.until", 0);
+  if (until == -1) {
+    return true;
+  }
+  return until > 0 && until > static_cast<int32_t>(PR_Now() / PR_USEC_PER_SEC);
+}
 }  // namespace
 
