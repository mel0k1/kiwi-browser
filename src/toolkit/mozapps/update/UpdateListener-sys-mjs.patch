+  // Kiwi: hide update prompts when the user asked not to be disturbed.
+  kiwiUpdateSuppressed(update) {
+    try {
+      if (update?.appVersion) {
+        Services.prefs.setStringPref(
+          "kiwi.updates.offered-version",
+          update.appVersion
+        );
+      }
+      if (Services.prefs.getBoolPref("kiwi.updates.dnd", false)) {
+        return true;
+      }
+      let snoozed = Services.prefs.getStringPref(
+        "kiwi.updates.dnd-version",
+        ""
+      );
+      return !!snoozed && !!update?.appVersion && update.appVersion == snoozed;
+    } catch (e) {
+      return false;
+    }
+  },
